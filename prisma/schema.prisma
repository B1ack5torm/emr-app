generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTION
  DOCTOR
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VisitStatus {
  WAITING
  COMPLETED
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  CANCELLED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  users     User[]
  patients  Patient[]
  invites   Invite[]
  invoices  Invoice[]
  appointments Appointment[]
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               Role?
  status             UserStatus   @default(PENDING)
  mustChangePassword Boolean      @default(false)
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id])
  organizationId     String
  visits             Visit[]      @relation("DoctorVisits")
  invoicesCreated    Invoice[]    @relation("InvoiceCreatedBy")
  paymentsRecorded   Payment[]    @relation("PaymentRecordedBy")
  appointments      Appointment[] @relation("DoctorAppointments")
}

model Patient {
  id               String       @id @default(cuid())
  mrn              String
  name             String
  age              Int
  dateOfBirth      DateTime?
  gender           Gender
  phone            String?
  address          String?
  bloodGroup       String?
  emergencyContact String?
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id])
  organizationId   String
  allergies        Allergy[]
  visits           Visit[]
  invoices         Invoice[]
  appointments     Appointment[]

  @@unique([organizationId, mrn])
}

model Allergy {
  id        String  @id @default(cuid())
  name      String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
}

model Visit {
  id             String         @id @default(cuid())
  status         VisitStatus    @default(WAITING)
  chiefComplaint String?
  bp             String?
  temperature    String?
  pulse          String?
  weight         String?
  diagnosis      String?
  doctorNotes    String?
  signedAt       DateTime?
  createdAt      DateTime       @default(now())
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId      String
  doctor         User?          @relation("DoctorVisits", fields: [doctorId], references: [id], onDelete: SetNull)
  doctorId       String?
  prescriptions  Prescription[]
  testsOrdered   TestOrder[]
  imagingOrders  ImagingOrder[]
  invoice       Invoice?
  appointment   Appointment? @relation("AppointmentVisit", fields: [appointmentId], references: [id])
  appointmentId String?      @unique
}

model Appointment {
  id             String            @id @default(cuid())
  scheduledAt    DateTime
  durationMinutes Int               @default(30)
  reason         String?
  status         AppointmentStatus @default(SCHEDULED)
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId      String
  doctor         User?             @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)
  doctorId       String?
  visit          Visit?            @relation("AppointmentVisit")

  @@index([organizationId, scheduledAt])
  @@index([doctorId, scheduledAt])
}

model Prescription {
  id        String  @id @default(cuid())
  medicine  String
  dosage    String?
  frequency String?
  duration  String?
  visit     Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId   String
}

model TestOrder {
  id      String @id @default(cuid())
  name    String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId String
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  role           Role
  token          String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  @@unique([email, organizationId])
}

enum ImagingModality {
  XRAY
  CT
  MRI
  ULTRASOUND
  NUCLEAR
  OTHER
}

enum OrderStatus {
  ORDERED
  SENT
  ACK_OK
  ACK_ERROR
  FAILED
}

model ImagingOrder {
  id                   String          @id @default(cuid())
  accessionNumber      String          @unique
  modality             ImagingModality
  procedureDescription String
  bodyPart             String?
  status               OrderStatus     @default(ORDERED)
  hl7Sent              String?
  hl7AckReceived       String?
  errorMessage         String?
  createdAt            DateTime        @default(now())
  sentAt               DateTime?
  visit                Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId              String
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum ItemCategory {
  CONSULTATION
  MEDICINE
  TEST
  IMAGING
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNo      Int
  visit          Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId        String        @unique
  patient        Patient       @relation(fields: [patientId], references: [id])
  patientId      String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  items          InvoiceItem[]
  payments       Payment[]
  subtotal       Int           @default(0)
  taxTotal       Int           @default(0)
  grandTotal     Int           @default(0)
  amountPaid     Int           @default(0)
  status         InvoiceStatus @default(UNPAID)
  createdAt      DateTime      @default(now())
  createdBy      User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?

  @@unique([organizationId, invoiceNo])
}

model InvoiceItem {
  id             String       @id @default(cuid())
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  category       ItemCategory
  description    String
  quantity       Int          @default(1)
  unitPrice      Int          @default(0)
  taxRatePercent Int          @default(0)
  amount         Int          @default(0)
  taxAmount      Int          @default(0)
  total          Int          @default(0)
}

model Payment {
  id           String        @id @default(cuid())
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    String
  amount       Int
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
}
