# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/emr
# Hosted example (Neon/Supabase): copy the connection string they give you
DATABASE_URL="postgresql://user:password@localhost:5432/emr"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

NEXTAUTH_URL="http://localhost:3000"

# Appointment notifications
# Use a verified Resend sender address for email confirmations.
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="CareChart <appointments@your-domain.com>"
APPOINTMENT_TIME_ZONE="Asia/Kolkata"

# DICOM Modality Worklist station AE Title (sent in HL7 OBR-19)
MWL_STATION_AETITLE="DG_HARVESTER"

# HL7 ORM / MLLP imaging integration
HL7_SENDER_APPLICATION="CARECHART"
HL7_SENDER_FACILITY="CARECHART_CLINIC"
HL7_RECEIVER_APPLICATION="IMAGING"
HL7_RECEIVER_FACILITY="MWL"
MLLP_HOST="127.0.0.1"
MLLP_PORT="2575"
MLLP_CONNECTION_TIMEOUT_MS="5000"
MLLP_READ_TIMEOUT_MS="10000"

# Local mock receiver (`npm run mllp:mock`). Never point this directory at source control.
MOCK_MLLP_HOST="127.0.0.1"
MOCK_MLLP_PORT="2575"
MOCK_MLLP_ACK_CODE="AA"
MOCK_MLLP_STORAGE_DIR="./storage/mllp-mock"

# Development document storage. Production deployments should provide an object-storage adapter.
DOCUMENT_STORAGE_DIR="./storage/development"
MAX_DOCUMENT_BYTES="10485760"
# Generate with: openssl rand -base64 32 (required in production).
DOCUMENT_ENCRYPTION_KEY=""
# Production scanner endpoint accepts the file bytes and returns JSON: {"safe":true}.
MALWARE_SCAN_URL=""
MALWARE_SCAN_TOKEN=""
